# Copy this file to .env and fill in real values. .env is gitignored - never commit real keys.
# Loaded automatically by every phase's demo entry point via src/shared/env.py's load_dotenv().

# Required. Every LLM call in this project (Phase 4/9c field extraction, Phase 10 query
# parsing, Phase 12/16 orchestration, the extraction cascade) goes through the Groq API.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Only used by src/cascade/semantic_search.py's local sentence-transformers model
# (all-MiniLM-L6-v2), downloaded from Hugging Face on first use. Without this, downloads work
# fine but are rate-limited and print an "unauthenticated requests" warning on every fresh
# download. Get a token at https://huggingface.co/settings/tokens - "Read" access is enough.
# HF_TOKEN=
